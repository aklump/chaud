#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-3-Clause

# ========= CONFIG =========
# Set to false and the configuration will be rechecked each execution bypassing the cache
# This avoids issues that arise when devices change and become unavailable.
ENABLE_CACHE=true
# ========= END CONFIG =========

# Must stay in sync with CreateChangeFunctions::getFunctionName() in PHP:
# every character outside [a-z0-9_] becomes an underscore.
get_function_by_input() {
  local user_input="$1"

  local suffix=$(echo "$user_input" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9_]/_/g')
  echo "change_to_$suffix"
}

s="${BASH_SOURCE[0]}";[[ "$s" ]] || s="${(%):-%N}";while [ -h "$s" ];do d="$(cd -P "$(dirname "$s")" && pwd)";s="$(readlink "$s")";[[ $s != /* ]] && s="$d/$s";done;__DIR__=$(cd -P "$(dirname "$s")" && pwd)


# Validate the input
if [[ $# -eq 0 ]]; then
  echo "❌ Missing argument - audio configuration name or alias."
  exit 1
fi

# Parse the arguments.  Flags are matched exactly and may appear in any
# position; the first non-flag argument is the audio configuration name or
# alias.  Substring matching here would let a legitimate label such as
# "line-check" or "my-video" trigger -c or -v.
verbose=false
flush_cache_requested=false
input=''
for arg in "$@"; do
  case "$arg" in
    -v) verbose=true ;;
    -c) flush_cache_requested=true ;;
    *) [[ ! "$input" ]] && input="$arg" ;;
  esac
done

ENABLE_CACHE=${ENABLE_CACHE:-false}
if [ "$ENABLE_CACHE" = true ]; then
    flush_cache=false
else
    flush_cache=true
fi
[[ "$flush_cache_requested" == true ]] && flush_cache=true

CACHE_PATH="${TMPDIR:-${TEMP:-/tmp}}"
CACHE_PATH="${CACHE_PATH%%/}/com.aklump.chaud"
export CACHE_PATH

if [[ "$flush_cache" == true ]]; then
  # Flush the cache so new config will be used, if it is changed.
  [[ "$CACHE_PATH" ]] && rm "$CACHE_PATH/"* &>/dev/null

  # Print the config getPath for user to open and edit.
  config_path="$("$__DIR__/bin/get_config_path.php")"
  [ ! -f "$config_path" ] && "$__DIR__/bin/install_config.php"
  echo "✏️ $config_path"
  [[ ! "$input" ]] && exit 0
fi

if [[ ! "$input" ]]; then
  echo "❌ Missing argument - audio configuration name or alias."
  exit 1
fi

if [[ "$input" == '-a' ]]; then
  "$__DIR__/bin/echo_all.php"
  exit 0
fi

if [[ "$input" == '-l' ]]; then
  "$__DIR__/bin/echo_options.php"
  exit 0
fi

# (Generate and) load the functions to change the audio by input.
change_functions_path="$CACHE_PATH/change_audio.sh"
[ $verbose == true ] && echo "🪲 $change_functions_path"
[ ! -f "$change_functions_path" ] && "$__DIR__/bin/create_change_functions.php" "$change_functions_path"
[ ! -f "$change_functions_path" ] && exit 1
source "$change_functions_path"

# Make the change.
change_function=$(get_function_by_input "$input")
if ! declare -F $change_function > /dev/null; then
  echo "❌ Unknown audio configuration: $input"
  "$__DIR__/bin/did_you_mean.php" "$input"
  exit 1
fi
[ $verbose == true ] && echo "🪲 $change_function()"
$change_function
