{
  "type": "object",
  "$def": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "integer"
          ]
        },
        "uid": {
          "type": "string",
          "description": "The CoreAudio UID of the device, which survives a reboot; used in preference to \"name\" when both are given.",
          "minLength": 1
        },
        "level": {
          "type": "number",
          "description": "A value from 0 to 1 for setting the device level.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "uid"
          ]
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input": {
            "$ref": "#/$def/device"
          },
          "output": {
            "$ref": "#/$def/device"
          },
          "scripts": {
            "type": "array"
          }
        },
        "required": [
          "label"
        ],
        "anyOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "output"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "options"
  ]
}
